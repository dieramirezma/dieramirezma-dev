# ─── Spotify ──────────────────────────────────────────────────────────────
# Crea una app en https://developer.spotify.com/dashboard
#   Redirect URI (ej.): http://127.0.0.1:3000/callback
# Scopes que debe tener el refresh token (Authorization Code flow):
#   user-read-currently-playing  → canción actual
#   user-read-recently-played    → última canción reproducida
#   user-top-read                → top tracks / artistas
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ─── Lichess ──────────────────────────────────────────────────────────────
# Los datos públicos no requieren token.
LICHESS_USERNAME=
# Opcional (sube el rate limit). Crear en https://lichess.org/account/oauth/token
# SIN ningún scope marcado (solo lectura de datos públicos).
LICHESS_API_TOKEN=

# ─── Chess.com ────────────────────────────────────────────────────────────
# La Published-Data API es pública: no usa API key ni permisos.
CHESSCOM_USERNAME=

# ─── AI Chatbot (optional) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://dieramirezma.dev
